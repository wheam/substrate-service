// recall 真实问句评测集 v0（知识库易用性首批 · 全脱敏 fixture = test/fixture/eval-instance）。
// JSONL，一行一条。字段：
//   id / category / question / trust
//   expect: "evidence"（应检到可引用证据）| "no-evidence"（当前库里就不该有可引用证据）
//   gold[]        —— 金标规则片段：必须出现在【服务端实际给出的证据】里（离线可判）
//   gold_paths[]  —— 证据必须覆盖到的页（离线可判）
//   must_not[]    —— 证据里绝不允许出现的串（越权/串页；离线可判）
//   must_not_paths[] —— 绝不允许出现的页（离线可判）
//   expect_tools[]         —— 期望宿主选用的工具（**离线不判**，只随报告带出，供真模型验收核对）
//   forbidden_conclusions[] —— 回答里不得出现的结论（**离线不判**，同上）
// 铁律：本文件里 expect_tools / forbidden_conclusions 属于「宿主与模型行为」，
// 假 provider 的输出永远不能当作它们的验收证据——详见 docs/08-knowledge-usability.md。

// ==== 显式查库（含截图里的原话形态） ====
{"id":"hotel-explicit","category":"explicit","trust":"high","question":"帮我查一下我个人知识库里的酒店规则","expect":"evidence","gold":["免费取消","1200"],"gold_paths":["knowledge/hotel-rules.md"],"expect_tools":["recall"],"forbidden_conclusions":["库里没存过酒店规则"]}
{"id":"hotel-cancel","category":"explicit","trust":"high","question":"我存过的订酒店规则里，取消政策是怎么要求的？","expect":"evidence","gold":["免费取消","不接受不可取消"],"gold_paths":["knowledge/hotel-rules.md"],"expect_tools":["recall"],"forbidden_conclusions":["可以订不可取消的特价房"]}
{"id":"hotel-exception","category":"explicit","trust":"high","question":"公司统一订的会议酒店可以超预算吗？","expect":"evidence","gold":["会议酒店","突破 1200"],"gold_paths":["knowledge/hotel-rules.md"],"expect_tools":["recall"],"forbidden_conclusions":["任何情况都不能超过 1200"]}
{"id":"hotel-scope","category":"explicit","trust":"high","question":"帮家里人订酒店也要按我的酒店规则来吗？","expect":"evidence","gold":["适用范围","替家人订"],"gold_paths":["knowledge/hotel-rules.md"],"expect_tools":["recall"],"forbidden_conclusions":["这套规则适用于所有人"]}
{"id":"flight-seat","category":"explicit","trust":"high","question":"我坐飞机偏好什么座位？","expect":"evidence","gold":["走道座位"],"gold_paths":["knowledge/flight-rules.md"],"expect_tools":["recall","search"],"forbidden_conclusions":["偏好靠窗"]}
{"id":"coffee-params","category":"explicit","trust":"high","question":"我手冲咖啡的水温和粉水比是多少？","expect":"evidence","gold":["92","1:15"],"gold_paths":["knowledge/coffee-brewing.md"],"expect_tools":["recall"],"forbidden_conclusions":["没有记录过手冲参数"]}
{"id":"decision-recall","category":"explicit","trust":"high","question":"我们此前关于后端方案选型的决定是什么？","expect":"evidence","gold":["A 方案","运维成本"],"gold_paths":["knowledge/decision-log.md"],"expect_tools":["recall"],"forbidden_conclusions":["选的是 B 方案"]}

// ==== 隐式个人偏好（主人没说「查知识库」，但答案依赖已存规则） ====
{"id":"hotel-implicit-book","category":"implicit","trust":"high","question":"帮我订一间出差住的酒店，1500 一晚、不可取消，可以吗？","expect":"evidence","gold":["1200","免费取消"],"gold_paths":["knowledge/hotel-rules.md"],"expect_tools":["recall"],"forbidden_conclusions":["可以，直接订"]}
{"id":"flight-implicit-redeye","category":"implicit","trust":"high","question":"帮我看看明早 6 点起飞的红眼航班合不合适","expect":"evidence","gold":["红眼航班","08:00"],"gold_paths":["knowledge/flight-rules.md"],"expect_tools":["recall"],"forbidden_conclusions":["这个时间没问题"]}
{"id":"flight-implicit-layover","category":"implicit","trust":"high","question":"这趟航班转机只有 45 分钟，够吗？","expect":"evidence","gold":["转机","90 分钟"],"gold_paths":["knowledge/flight-rules.md"],"expect_tools":["recall"],"forbidden_conclusions":["45 分钟够用"]}
{"id":"memory-nickname","category":"implicit","trust":"high","question":"我喜欢别人怎么称呼我？","expect":"evidence","gold":["小林"],"gold_paths":["memory/about-owner/core-summary.md"],"expect_tools":["get_context","recall"],"forbidden_conclusions":["不知道你的称呼偏好"]}
{"id":"dessert-health","category":"implicit","trust":"high","question":"给我推荐个甜品，我点单有什么要避开的吗？","expect":"evidence","gold":["乳糖不耐","牛奶"],"gold_paths":["memory/about-owner/health.md"],"expect_tools":["recall","get_context"],"forbidden_conclusions":["没有饮食限制"]}
{"id":"restaurant-collection","category":"implicit","trust":"high","question":"我收藏过哪些餐厅？","expect":"evidence","gold":["data.csv","collections_search"],"gold_paths":["collections/restaurants/README.md"],"expect_tools":["collections_search"],"forbidden_conclusions":["你没有收藏过餐厅"]}
{"id":"todo-recall","category":"implicit","trust":"high","question":"我还有什么待办没做？","expect":"evidence","gold":["报税"],"gold_paths":["todo/owner.md"],"expect_tools":["todo_list","recall"],"forbidden_conclusions":["待办是空的"]}

// ==== 跨会话保存 / 纠正：新旧冲突必须两边都在证据里 ====
{"id":"hotel-old-budget","category":"correction","trust":"high","question":"我的酒店预算上限还是 800 吗？","expect":"evidence","gold":["800","1200","作废"],"gold_paths":["knowledge/hotel-rules.md"],"expect_tools":["recall"],"forbidden_conclusions":["现行上限是 800 元"]}
{"id":"coffee-changed","category":"correction","trust":"high","question":"我改过手冲的水温偏好吗？浅烘豆用多少度？","expect":"evidence","gold":["94","92"],"gold_paths":["knowledge/coffee-brewing.md"],"expect_tools":["recall"],"forbidden_conclusions":["从没改过水温"]}

// ==== 负例：与主人无关的通用问题，不该被个人内容带偏 ====
{"id":"negative-boiling","category":"negative","trust":"high","question":"标准大气压下水的沸点是多少度？","expect":"no-evidence","expect_tools":[],"forbidden_conclusions":["根据你知识库里的记录"]}
{"id":"negative-fx","category":"negative","trust":"high","question":"今天美元兑人民币的汇率是多少？","expect":"no-evidence","expect_tools":[],"forbidden_conclusions":["根据你知识库里的记录"]}

// ==== 不存在的内容：未检索到 ≠ 主人从未保存 ====
{"id":"missing-diving","category":"missing","trust":"high","question":"我存过关于潜水执照的规定吗？","expect":"no-evidence","known_gap":true,"gap_note":"词法召回的已知精度缺口：问句里的功能词 bigram（如「关于」）会把无关页拉进候选。同义/词法改进不在本批范围，本条只做退化监控，不进通过率门槛。","expect_tools":["recall","search"],"forbidden_conclusions":["你从来没有保存过潜水相关内容","库里没存过"]}
{"id":"missing-diving-plain","category":"missing","trust":"high","question":"我存过潜水执照相关的规定吗？","expect":"no-evidence","expect_tools":["recall","search"],"forbidden_conclusions":["你从来没有保存过潜水相关内容","库里没存过"]}
{"id":"missing-pet","category":"missing","trust":"high","question":"我的宠物叫什么名字？","expect":"no-evidence","known_gap":true,"gap_note":"同一个词法精度缺口的另一触发词：「我的」这类功能词 bigram 也会拉进无关页（此处是 todo/owner.md 的标题「我的待办」）。","expect_tools":["recall","search"],"forbidden_conclusions":["你从来没有保存过宠物相关内容","库里没存过"]}

// ==== ACL：低信任连接绝不该从敏感区拿到证据（也不得据此反推有没有） ====
{"id":"memory-low-trust","category":"acl","trust":"low","question":"我喜欢别人怎么称呼我？","expect":"no-evidence","must_not":["小林"],"must_not_paths":["memory/about-owner/core-summary.md"],"expect_tools":[],"forbidden_conclusions":["主人没保存过称呼偏好"]}

